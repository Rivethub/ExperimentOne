{
  "name": "rivet-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=128000' vp dev",
    "dev:mock": "VITE_MOCK_IPC=1 NODE_OPTIONS='--max-http-header-size=128000' vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "tauri": "tauri",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "tsc -b --pretty false",
    "test": "vp test",
    "check": "vp fmt --check && vp lint --deny-warnings && tsc -b --pretty false && vp test"
  },
  "dependencies": {
    "@effect/atom-solid": "4.1.2",
    "@effect/platform-browser": "4.1.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/solid-query": "^5.107.1",
    "@tanstack/solid-router": "^1.170.43",
    "@tanstack/solid-virtual": "^3.13.53",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cva": "1.0.0-beta.4",
    "effect": "^4.1.2",
    "lucide-solid": "^1.70.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "solid-js": "^1.9.18",
    "solid-markdown": "^2.1.1",
    "solid-sonner": "^0.3.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@seanmozeik/de-clank": "^0.1.11",
    "@tanstack/router-plugin": "^1.169.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "oxc-config-ai-guardrails": "^1.1.0",
    "oxlint": "^1.92.0",
    "oxlint-anti-slop": "^0.4.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "npm:@tsc-rs/typescript@0.8.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plugin-solid": "^2.11.15",
    "vite-plus": "1.5.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "typescript": "$typescript",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@tsc-rs/typescript",
    "typescript"
  ]
}
