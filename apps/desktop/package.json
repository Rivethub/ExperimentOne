{
  "name": "rivet-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:mock": "VITE_MOCK_IPC=1 vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "tauri": "tauri",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "tsc -b --pretty false",
    "check": "vp fmt --check && vp lint --deny-warnings && tsc -b --pretty false"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "effect": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxc-transform-react": "^0.156.0",
    "typescript": "npm:@tsc-rs/typescript@0.8.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "typescript": "$typescript",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@tsc-rs/typescript",
    "typescript"
  ]
}
