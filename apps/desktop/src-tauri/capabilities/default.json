{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Rivet desktop capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "shell:allow-open",
    "shell:allow-spawn",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/rivetd", "sidecar": true },
        { "name": "binaries/rivet-proxy", "sidecar": true },
        { "name": "binaries/clickhouse", "sidecar": true }
      ]
    }
  ]
}
