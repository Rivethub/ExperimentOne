{
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn",
    "nursery": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "src-tauri/**",
    "node_modules/**",
    "gen-oxlint.mjs",
    "oxlint.config.json"
  ],
  "jsPlugins": [
    {
      "name": "de-clank",
      "specifier": "@seanmozeik/de-clank/core"
    },
    {
      "name": "de-clank-effect",
      "specifier": "@seanmozeik/de-clank/effect"
    },
    {
      "name": "de-clank-react",
      "specifier": "@seanmozeik/de-clank/react"
    },
    {
      "name": "anti-slop",
      "specifier": "oxlint-anti-slop"
    },
    {
      "name": "vite-plus",
      "specifier": "vite-plus/oxlint-plugin"
    }
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn",
    "typeAware": true,
    "typeCheck": true
  },
  "overrides": [
    {
      "files": [
        "**/*.{cts,mts,ts,tsx}"
      ],
      "rules": {
        "no-redeclare": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.js",
        "**/*.spec.js",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-statements": "off",
        "max-nested-callbacks": "off",
        "max-classes-per-file": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "**/*.d.ts"
      ],
      "rules": {
        "typescript/method-signature-style": "off",
        "typescript/no-explicit-any": "off",
        "max-lines": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      "files": [
        "**/*.tsx",
        "**/*.jsx"
      ],
      "rules": {
        "max-lines-per-function": [
          "warn",
          {
            "max": 160,
            "skipBlankLines": true
          }
        ]
      }
    },
    {
      "files": [
        "src/effect/ipc.ts",
        "src/lib/api.ts"
      ],
      "rules": {
        "de-clank/no-unvalidated-json-parse": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-type-parameters": "off",
        "de-clank/no-unknown-parameters": "off",
        "unicorn/no-useless-undefined": "off"
      }
    },
    {
      "files": [
        "src/effect/errors.ts"
      ],
      "rules": {
        "max-classes-per-file": "off"
      }
    },
    {
      "files": [
        "src/lib/tauri-utils.ts"
      ],
      "rules": {
        "de-clank/no-default-on-catch": "off"
      }
    }
  ],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "jsdoc",
    "react",
    "jsx-a11y",
    "react-perf",
    "vitest"
  ],
