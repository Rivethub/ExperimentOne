{
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn",
    "nursery": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "src-tauri/**",
    "node_modules/**",
    "gen-oxlint.mjs",
    "oxlint.config.json"
  ],
  "jsPlugins": [
    {
      "name": "de-clank",
      "specifier": "@seanmozeik/de-clank/core"
    },
    {
      "name": "de-clank-effect",
      "specifier": "@seanmozeik/de-clank/effect"
    },
    {
      "name": "anti-slop",
      "specifier": "oxlint-anti-slop"
    },
    {
      "name": "vite-plus",
      "specifier": "vite-plus/oxlint-plugin"
    }
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn",
    "typeAware": true,
    "typeCheck": true
  },
  "overrides": [
    {
      "files": ["**/*.{cts,mts,ts,tsx}"],
      "rules": {
        "no-redeclare": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.js",
        "**/*.spec.js",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-statements": "off",
        "max-nested-callbacks": "off",
        "max-classes-per-file": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/method-signature-style": "off",
        "typescript/no-explicit-any": "off",
        "max-lines": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      "files": ["**/*.tsx", "**/*.jsx"],
      "rules": {
        "max-lines-per-function": [
          "warn",
          {
            "max": 160,
            "skipBlankLines": true
          }
        ]
      }
    },
    {
      "files": ["src/effect/ipc.ts"],
      "rules": {
        "de-clank/no-unvalidated-json-parse": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-type-parameters": "off",
        "de-clank/no-unknown-parameters": "off",
        "unicorn/no-useless-undefined": "off"
      }
    },
    {
      "files": ["src/effect/errors.ts"],
      "rules": {
        "max-classes-per-file": "off"
      }
    },
    {
      "files": ["src/lib/tauri-utils.ts"],
      "rules": {
        "de-clank/no-default-on-catch": "off"
      }
    }
  ],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "jsdoc",
    "jsx-a11y",
    "vitest"
  ],
  "rules": {
    "de-clank/no-array-filter-map": "warn",
    "de-clank/no-reduce-accumulator-copy": "warn",
    "de-clank/require-readable-spacing": "off",
    "de-clank/enforce-import-boundaries": "warn",
    "de-clank/no-accumulator-spread-in-reduce": "warn",
    "de-clank/no-accumulator-spread-in-loop": "warn",
    "de-clank/no-async-local-storage-enter-with": "warn",
    "de-clank/no-chained-type-assertions": "warn",
    "de-clank/no-closing-brace-labels": "warn",
    "de-clank/no-conditional-empty-object-spread": "warn",
    "de-clank/no-cross-package-relative-imports": "warn",
    "de-clank/no-default-on-catch": "warn",
    "de-clank/no-date-only-date-constructor": "warn",
    "de-clank/no-decorative-section-comments": "warn",
    "de-clank/no-development-stage-labels": "warn",
    "de-clank/no-dynamic-string-replacement": "warn",
    "de-clank/no-environment-access-outside-boundary": "warn",
    "de-clank/no-focused-tests": "warn",
    "de-clank/no-flat-prefix-clusters": "warn",
    "de-clank/no-heavy-cli-import-paths": "warn",
    "de-clank/no-known-value-widening": "warn",
    "de-clank/no-locale-compare-in-sort": "warn",
    "de-clank/no-module-mocking": "warn",
    "de-clank/no-narration-comments": "warn",
    "de-clank/no-module-directory-collisions": "warn",
    "de-clank/no-never-test-fixtures": "warn",
    "de-clank/no-object-parameters": "warn",
    "de-clank/no-overloaded-directories": "warn",
    "de-clank/no-overlong-comments": "warn",
    "de-clank/no-partial-record-satisfies": "warn",
    "de-clank/no-pass-through-wrappers": "warn",
    "de-clank/no-pass-through-facade-classes": "warn",
    "de-clank/no-personal-test-data": "warn",
    "de-clank/no-placeholder-implementations": "warn",
    "de-clank/no-project-history-comments": "warn",
    "de-clank/no-prototype-test-mutation": "warn",
    "de-clank/no-redundant-doc-comments": "warn",
    "de-clank/no-redundant-path-segments-in-filenames": "warn",
    "de-clank/no-redundant-testing-library-getby-assertion": "warn",
    "de-clank/no-reflect-apply": "warn",
    "de-clank/no-reflect-get": "warn",
    "de-clank/no-runtime-typeof": "off",
    "de-clank/require-fetch-cancellation": "warn",
    "de-clank/no-shape-in-symbol-names": "warn",
    "de-clank/no-shell-string-execution": "warn",
    "de-clank/no-source-inspection-tests": "warn",
    "de-clank/no-test-only-production-code": "warn",
    "de-clank/no-unknown-parameters": [
      "warn",
      {
        "allowBoundaryFunctions": true,
        "allowedFilePatterns": ["/src/effect/ipc\\.ts$", "/src/mock/", "/src/lib/tauri-utils\\.ts$"]
      }
    ],
    "de-clank/no-unknown-returns": "warn",
    "de-clank/no-unknown-type-aliases": "warn",
    "de-clank/no-unvalidated-json-parse": "warn",
    "de-clank/no-unvalidated-json-body": "warn",
    "de-clank/no-unowned-source-root-files": [
      "warn",
      {
        "allowed": ["App.tsx", "main.tsx", "vite-env.d.ts"]
      }
    ],
    "de-clank/no-unsafe-dictionary-type": "warn",
    "de-clank/no-widen-then-assert": "warn",
    "de-clank/no-work-item-references": "warn",
    "de-clank/require-justified-suppressions": "warn",
    "de-clank/require-safety-comment-for-type-assertion": "off",
    "de-clank/js-async-reduce-without-awaited-acc": "warn",
    "de-clank/js-hoist-intl": "warn",
    "de-clank/js-hoist-regexp": "warn",
    "de-clank/js-set-map-lookups": "warn",
    "de-clank/no-arithmetic-on-optional-chained-operand": "warn",
    "de-clank/no-array-find-result-member-access-without-guard": "warn",
    "de-clank/no-array-index-deref-without-bounds-or-empty-guard": "warn",
    "de-clank/no-barrel-import": "off",
    "de-clank/no-create-object-url-without-revoke": "warn",
    "de-clank/no-deprecated-keyboard-event-keycode-which": "warn",
    "de-clank/no-document-start-view-transition": "warn",
    "de-clank/no-dynamic-import-path": "warn",
    "de-clank/no-fetch-response-used-without-status-check": "warn",
    "de-clank/no-fill-map-element-as-key": "warn",
    "de-clank/no-full-lodash-import": "warn",
    "de-clank/no-json-parse-stringify-clone": "warn",
    "de-clank/no-loading-flag-reset-outside-finally": "warn",
    "de-clank/no-moment": "warn",
    "de-clank/no-non-literal-selector-query-without-try-catch": "warn",
    "de-clank/no-nullish-coalescing-arithmetic-precedence": "warn",
    "de-clank/no-object-keys-values-entries-on-maybe-undefined": "warn",
    "de-clank/no-object-or-array-coerced-to-string-in-template-literal": "warn",
    "de-clank/no-path-prefix-containment": "warn",
    "de-clank/no-sync-xhr": "warn",
    "de-clank/no-unescaped-dynamic-string-in-regexp": "warn",
    "de-clank/no-whole-object-default-losing-per-key-defaults": "warn",
    "de-clank/prefer-dynamic-import": "warn",
    "de-clank/window-open-without-noopener": "warn",
    "de-clank/no-heavy-cli-entrypoint-imports": "warn",
    "jsdoc/check-access": "warn",
    "jsdoc/check-property-names": "warn",
    "jsdoc/check-tag-names": [
      "warn",
      {
        "definedTags": [
          "jest-environment",
          "jest-environment-options",
          "vitest-environment",
          "vitest-environment-options",
          "worklet"
        ],
        "jsxTags": true
      }
    ],
    "jsdoc/empty-tags": "warn",
    "jsdoc/implements-on-classes": "warn",
    "jsdoc/no-blank-blocks": "warn",
    "jsdoc/no-defaults": "warn",
    "jsdoc/require-param": "off",
    "jsdoc/require-param-description": "off",
    "jsdoc/require-param-name": "off",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-property": "off",
    "jsdoc/require-property-description": "off",
    "jsdoc/require-property-name": "off",
    "jsdoc/require-property-type": "off",
    "jsdoc/require-returns": "off",
    "jsdoc/require-returns-description": "off",
    "jsdoc/require-returns-type": "off",
    "jsdoc/require-throws-description": "off",
    "jsdoc/require-throws-type": "off",
    "jsdoc/require-yields": "off",
    "jsdoc/require-yields-description": "off",
    "jsdoc/require-yields-type": "off",
    "capitalized-comments": "off",
    "arrow-body-style": ["warn", "as-needed"],
    "id-length": "off",
    "import/consistent-type-specifier-style": "off",
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/max-dependencies": "off",
    "import/no-anonymous-default-export": "off",
    "import/no-default-export": "off",
    "import/no-named-export": "off",
    "import/no-namespace": "warn",
    "import/no-nodejs-modules": "off",
    "import/no-unassigned-import": "off",
    "import/no-relative-parent-imports": "off",
    "import/prefer-default-export": "off",
    "import/unambiguous": "off",
    "init-declarations": "off",
    "max-classes-per-file": ["warn", 1],
    "max-lines": [
      "warn",
      {
        "max": 400,
        "skipBlankLines": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 120,
        "skipBlankLines": true
      }
    ],
    "max-params": ["warn", 5],
    "max-statements": ["warn", 40],
    "new-cap": [
      "warn",
      {
        "capIsNewExceptions": [
          "Any",
          "Array",
          "BigDecimal",
          "BigInt",
          "Boolean",
          "Class",
          "Date",
          "Defect",
          "Effect",
          "ErrorClass",
          "Layer",
          "Literal",
          "Literals",
          "Map",
          "Match",
          "Never",
          "NonEmptyArray",
          "Null",
          "NullishOr",
          "NullOr",
          "Number",
          "NumberFromString",
          "Object",
          "Option",
          "Record",
          "Redacted",
          "Schema",
          "Service",
          "Set",
          "String",
          "Struct",
          "Symbol",
          "TaggedClass",
          "TaggedError",
          "TaggedStruct",
          "Tuple",
          "Undefined",
          "UndefinedOr",
          "Union",
          "Unknown",
          "Void"
        ]
      }
    ],
    "no-console": "warn",
    "no-await-in-loop": "warn",
    "no-bitwise": "off",
    "no-debugger": "warn",
    "no-magic-numbers": "off",
    "no-optional-chaining": "off",
    "no-rest-spread-properties": "off",
    "no-ternary": "off",
    "no-undefined": "off",
    "no-underscore-dangle": "off",
    "no-useless-computed-key": "off",
    "no-use-before-define": "off",
    "one-var": ["warn", "never"],
    "oxc/no-async-await": "off",
    "promise/avoid-new": "off",
    "promise/prefer-await-to-callbacks": "off",
    "promise/prefer-await-to-then": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "sort-vars": "off",
    "typescript/array-type": "warn",
    "typescript/ban-ts-comment": "warn",
    "typescript/consistent-type-definitions": "off",
    "typescript/consistent-type-imports": "warn",
    "typescript/dot-notation": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-member-accessibility": "off",
    "typescript/explicit-module-boundary-types": "warn",
    "typescript/no-base-to-string": "warn",
    "typescript/no-deprecated": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/no-generated-empty-object-type": "warn",
    "typescript/no-inferrable-types": "warn",
    "typescript/no-misused-promises": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unnecessary-condition": "warn",
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/parameter-properties": "warn",
    "typescript/prefer-readonly": "warn",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/promise-function-async": "off",
    "typescript/restrict-template-expressions": "warn",
    "typescript/strict-boolean-expressions": "warn",
    "typescript/strict-void-return": "warn",
    "typescript/switch-exhaustiveness-check": "warn",
    "unicorn/explicit-length-check": "warn",
    "unicorn/no-null": "off",
    "unicorn/no-array-method-this-argument": "off",
    "unicorn/catch-error-name": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/number-literal-case": "off",
    "unicorn/prefer-spread": "off",
    "unicorn/no-process-exit": "off",
    "unicorn/throw-new-error": "warn",
    "de-clank-effect/no-ambient-nondeterminism-in-effect": "warn",
    "de-clank-effect/no-anonymous-effect-generators": "warn",
    "de-clank-effect/no-effect-internal-tags": "warn",
    "de-clank-effect/no-inline-schema-construction": "warn",
    "de-clank-effect/no-parallel-schema-types": "warn",
    "de-clank-effect/no-run-effect-inside-effect": "warn",
    "de-clank-effect/no-silent-effect-error-swallow": "warn",
    "de-clank-effect/no-static-effect-service-forwarders": "warn",
    "de-clank-effect/no-throw-in-effect-generator": "warn",
    "de-clank-effect/prefer-effect-schema-boundary-decoding": [
      "warn",
      {
        "assumeEffectProject": true
      }
    ],
    "jsx-a11y/no-autofocus": "off",
    "vitest/prefer-called-times": "off",
    "vitest/consistent-test-it": "off",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/no-hooks": "off",
    "vitest/require-test-timeout": "off",
    "vitest/require-hook": "off",
    "vitest/require-top-level-describe": "off",
    "vitest/prefer-expect-assertions": "off",
    "vitest/prefer-to-be-falsy": "off",
    "vitest/prefer-to-be-truthy": "off",
    "vitest/prefer-to-have-been-called-times": "off",
    "func-style": "off",
    "prefer-arrow-callback": "warn",
    "no-var": "warn",
    "prefer-const": [
      "warn",
      {
        "destructuring": "any"
      }
    ],
    "no-param-reassign": [
      "warn",
      {
        "props": true
      }
    ],
    "no-plusplus": "warn",
    "no-void": "off",
    "no-else-return": [
      "warn",
      {
        "allowElseIf": false
      }
    ],
    "no-lonely-if": "warn",
    "curly": ["warn", "all"],
    "oxc/no-this-in-exported-function": "warn",
    "no-warning-comments": [
      "warn",
      {
        "terms": ["todo", "fixme", "xxx", "hack"],
        "location": "anywhere"
      }
    ],
    "max-depth": ["warn", 4],
    "complexity": ["warn", 30],
    "max-nested-callbacks": ["warn", 4],
    "no-continue": "warn",
    "no-labels": "warn",
    "no-loop-func": "warn",
    "guard-for-in": "warn",
    "import/no-cycle": "warn",
    "import/no-duplicates": "warn",
    "import/first": "warn",
    "import/newline-after-import": "warn",
    "import/no-mutable-exports": "warn",
    "typescript/method-signature-style": ["warn", "property"],
    "typescript/no-restricted-types": "warn",
    "typescript/no-empty-object-type": "warn",
    "typescript/consistent-indexed-object-style": ["warn", "record"],
    "no-restricted-properties": [
      "warn",
      {
        "object": "Reflect",
        "property": "get",
        "message": "Reflect.get returns any. Parse the value at the boundary instead."
      },
      {
        "object": "Reflect",
        "property": "apply",
        "message": "Reflect.apply returns any. Call the typed function instead."
      },
      {
        "object": "vi",
        "property": "mock",
        "message": "A module mock hides the real seam. Inject the dependency instead."
      },
      {
        "object": "vi",
        "property": "doMock",
        "message": "A module mock hides the real seam. Inject the dependency instead."
      },
      {
        "object": "jest",
        "property": "mock",
        "message": "A module mock hides the real seam. Inject the dependency instead."
      }
    ],
    "unicorn/prefer-at": "warn",
    "unicorn/prefer-negative-index": "warn",
    "unicorn/prefer-array-find": "warn",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-includes": "warn",
    "unicorn/prefer-set-has": "warn",
    "unicorn/prefer-optional-catch-binding": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/prefer-number-properties": "warn",
    "unicorn/no-abusive-eslint-disable": "warn",
    "prefer-exponentiation-operator": "warn",
    "no-eval": "warn",
    "no-new-func": "warn",
    "no-script-url": "warn",
    "oxc/no-async-endpoint-handlers": "warn",
    "typescript/await-thenable": "warn",
    "typescript/no-implied-eval": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/prefer-nullish-coalescing": "warn",
    "typescript/prefer-optional-chain": "warn",
    "anti-slop/no-chained-type-assertions": "warn",
    "anti-slop/no-unnecessary-type-widening": "warn",
    "anti-slop/no-object-parameters": "warn",
    "anti-slop/no-reduce-accumulator-copy": "warn",
    "anti-slop/no-typeof-outside-guards": "warn",
    "anti-slop/no-meaningless-unknown-aliases": "warn",
    "anti-slop/no-unsafe-dictionary-values": "warn",
    "anti-slop/no-narrowing-after-widening": "warn",
    "anti-slop/require-type-assertion-justification": "warn",
    "anti-slop/tests-require-given-when-then": "warn",
    "vite-plus/prefer-vite-plus-imports": "warn",
    "anti-slop/require-logical-blank-lines": "off",
    "unicorn/filename-case": [
      "warn",
      {
        "cases": {
          "kebabCase": true,
          "pascalCase": true
        }
      }
    ],
    "oxc/no-barrel-file": "warn",
    "func-names": "warn",
    "eslint/no-negated-condition": "off",
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "typescript/no-unnecessary-type-parameters": "warn",
    "unicorn/no-useless-undefined": "warn"
  },
  "settings": {},
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true,
    "node": true
  }
}
