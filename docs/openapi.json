{
  "openapi": "3.1.0",
  "info": {
    "title": "Rivet Control API",
    "description": "Local control plane for the Rivet desktop app, CLI, and ingest.",
    "contact": {
      "name": "Rivet"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/captures/recent": {
      "get": {
        "tags": [
          "capture"
        ],
        "operationId": "recent",
        "responses": {
          "200": {
            "description": "Recent capture events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CaptureEvent"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/config": {
      "get": {
        "tags": [
          "control"
        ],
        "operationId": "get_config",
        "responses": {
          "200": {
            "description": "Public config",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "tags": [
          "live"
        ],
        "operationId": "live_events_doc",
        "responses": {
          "200": {
            "description": "Server-Sent Events stream (`text/event-stream`) of live bus updates"
          }
        }
      }
    },
    "/v1/live": {
      "get": {
        "tags": [
          "live"
        ],
        "operationId": "live_cursor_doc",
        "responses": {
          "200": {
            "description": "Live refresh cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveCursor"
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": [
          "control"
        ],
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI 3 document for the control API"
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "tags": [
          "control"
        ],
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Control plane status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountInfo": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "label",
          "limit_hint",
          "reset_hint"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "limit_hint": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "reset_hint": {
            "type": "string"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "description": "Feature flags driven by what the user has configured.",
        "required": [
          "mcp",
          "vector_search",
          "wiki",
          "teams"
        ],
        "properties": {
          "mcp": {
            "type": "boolean",
            "description": "Keyword/SQL history via MCP always on once captures exist."
          },
          "teams": {
            "type": "boolean",
            "description": "Enterprise / multi-user (disabled in local MVP)."
          },
          "vector_search": {
            "type": "boolean",
            "description": "Lexical vector search over `ClickHouse` embeddings (on by default locally)."
          },
          "wiki": {
            "type": "boolean",
            "description": "Requires a text-generation model routed through the proxy (or stub wiki pages)."
          }
        }
      },
      "CaptureEvent": {
        "type": "object",
        "description": "One captured unit of proxy captures. Safe to export (no credentials).",
        "required": [
          "id",
          "ts",
          "provider",
          "role",
          "tokens_in",
          "tokens_out"
        ],
        "properties": {
          "account_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "agent_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Subagent id from proxy headers (e.g. `x-claude-code-agent-id`). Absent on main turns."
          },
          "agent_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Agent type / name when present (`x-claude-code-agent-type`)."
          },
          "api_format": {
            "type": [
              "string",
              "null"
            ],
            "description": "Wire API shape: `anthropic_messages` | `openai_chat` | `openai_responses` | `gemini` | …"
          },
          "attempt_count": {
            "type": "integer",
            "format": "int32",
            "description": "Number of upstream credential attempts (failover > 1).",
            "minimum": 0
          },
          "auth_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Credential-pool `auth_id` from the winning upstream attempt."
          },
          "body_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Relative path under blobs/ when body was spilled to disk."
          },
          "cache_creation_tokens": {
            "type": "integer",
            "format": "int32",
            "description": "Anthropic cache-creation tokens (also folded into `tokens_in`).",
            "minimum": 0
          },
          "cache_read_tokens": {
            "type": "integer",
            "format": "int32",
            "description": "Anthropic / `OpenAI` cache-read tokens (also folded into `tokens_in`).",
            "minimum": 0
          },
          "capture_quality": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CaptureQuality",
                "description": "Capture fidelity: `wire`, `soft`, or `imported`."
              }
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Working-directory signal when present on wire or local transcript. Soft context for workers —\nnot promoted to `project_id` by itself."
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Short provider error message (redacted/truncated)."
          },
          "error_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Provider error type/code when status ≥ 400 or body is an error envelope."
          },
          "git_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "Git branch from request `git_state` when present on the wire."
          },
          "git_repo": {
            "type": [
              "string",
              "null"
            ],
            "description": "Git repo root / remote from `git_state` when present."
          },
          "has_thinking": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "True when thinking/reasoning blocks were present on the wire."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "latency_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "media_count": {
            "type": "integer",
            "format": "int32",
            "description": "Count of image/file/audio/video parts seen in request/response.",
            "minimum": 0
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_agent_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Parent agent id when nested (`x-claude-code-parent-agent-id`)."
          },
          "parent_session_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Parent session when child uses its own session id (e.g. `OpenCode` `x-parent-session-id`)."
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Hard-evidence project id only: explicit API/header field, or the harness's own project key\n(e.g. Claude/Cursor `projects/<id>/` folder). Never inferred from cwd or prompt text."
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderKind"
          },
          "request_class": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request class: `main` | `subagent` | `workflow` | `compaction` | `auxiliary`."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Client request path (`/v1/messages`, `/v1/responses`, …)."
          },
          "role": {
            "$ref": "#/components/schemas/CaptureRole"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "soft_alias": {
            "type": [
              "string",
              "null"
            ],
            "description": "Soft fingerprint that this wire session supersedes (soft→wire upgrade).\nNot persisted to `ClickHouse` — ingest records it into meta aliases."
          },
          "status_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "stop_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Provider stop / finish reason when present."
          },
          "stream_complete": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the captured stream looked complete (`[DONE]` / `message_stop`)."
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Task lineage id from headers / body metadata."
          },
          "thinking_tokens": {
            "type": "integer",
            "format": "int32",
            "description": "Thinking / reasoning tokens when reported separately.",
            "minimum": 0
          },
          "tokens_in": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "tokens_out": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "tool_call_count": {
            "type": "integer",
            "format": "int32",
            "description": "Number of tool/function invocations observed on this turn.",
            "minimum": 0
          },
          "tool_names": {
            "type": [
              "string",
              "null"
            ],
            "description": "Comma-separated tool names invoked on this turn (wire parse)."
          },
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "turn_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Turn lineage id from headers / body metadata."
          },
          "upstream_host": {
            "type": [
              "string",
              "null"
            ],
            "description": "Hostname of the winning upstream attempt (credential pool)."
          }
        }
      },
      "CaptureQuality": {
        "type": "string",
        "description": "How the event was captured / how trustworthy the session linkage is.",
        "enum": [
          "wire",
          "soft",
          "imported"
        ]
      },
      "CaptureRole": {
        "type": "string",
        "enum": [
          "system",
          "user",
          "assistant",
          "tool",
          "unknown"
        ]
      },
      "ConversationSummary": {
        "type": "object",
        "description": "One historical conversation, projected from capture events sharing a session.",
        "required": [
          "id",
          "title",
          "provider",
          "started_at",
          "updated_at",
          "message_count",
          "tokens_in",
          "tokens_out"
        ],
        "properties": {
          "agent_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Distinct subagent ids observed in this conversation (from proxy headers)."
          },
          "api_format": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest observed API format."
          },
          "cache_read_tokens": {
            "type": "integer",
            "format": "int64",
            "description": "Sum of cache-read tokens across the conversation.",
            "minimum": 0
          },
          "capture_quality": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CaptureQuality",
                "description": "Worst fidelity seen in the conversation (`soft` < `imported` < `wire`)."
              }
            ]
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest captured cwd signal for the conversation (not a classified project)."
          },
          "error_events": {
            "type": "integer",
            "format": "int64",
            "description": "Events with an error envelope / non-success capture.",
            "minimum": 0
          },
          "git_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest git branch signal."
          },
          "id": {
            "type": "string",
            "description": "`session_id`, or `event:{uuid}` when the event has no session."
          },
          "media_count": {
            "type": "integer",
            "format": "int64",
            "description": "Sum of media parts across the conversation.",
            "minimum": 0
          },
          "message_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "preview": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderKind"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "subagent_events": {
            "type": "integer",
            "format": "int64",
            "description": "Events tagged as subagent / workflow turns.",
            "minimum": 0
          },
          "thinking_events": {
            "type": "integer",
            "format": "int64",
            "description": "Events that included thinking/reasoning on the wire.",
            "minimum": 0
          },
          "thinking_tokens": {
            "type": "integer",
            "format": "int64",
            "description": "Sum of thinking / reasoning tokens across the conversation.",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "tokens_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tokens_out": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tool_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Distinct tool names observed on the wire."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LiveCursor": {
        "type": "object",
        "description": "Cheap snapshot for long-poll / Tauri watchers (no stream required).",
        "required": [
          "wiki_revision",
          "capture_events",
          "observed_at"
        ],
        "properties": {
          "capture_events": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "observed_at": {
            "type": "string"
          },
          "wiki_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "LocalSession": {
        "type": "object",
        "required": [
          "api_key",
          "note"
        ],
        "properties": {
          "api_key": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "OnboardingStatus": {
        "type": "object",
        "required": [
          "proxy_running",
          "has_accounts",
          "has_captures",
          "harness_ready"
        ],
        "properties": {
          "harness_ready": {
            "type": "boolean"
          },
          "has_accounts": {
            "type": "boolean"
          },
          "has_captures": {
            "type": "boolean"
          },
          "proxy_running": {
            "type": "boolean"
          }
        }
      },
      "ProviderKind": {
        "type": "string",
        "enum": [
          "Claude",
          "Codex",
          "OpenAi",
          "Gemini",
          "Antigravity",
          "Kimi",
          "KimiAi",
          "Xai",
          "Meta",
          "Devin",
          "Vertex",
          "Cursor",
          "Other"
        ]
      },
      "PublicConfig": {
        "type": "object",
        "description": "Config returned to the UI — never includes live secrets.",
        "required": [
          "proxy_port",
          "api_port",
          "mcp_port",
          "clickhouse_http_port",
          "clickhouse_native_port",
          "access_key_hint",
          "management_configured",
          "capabilities",
          "wiki_project_id"
        ],
        "properties": {
          "access_key_hint": {
            "type": "string"
          },
          "api_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "clickhouse_http_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "clickhouse_native_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "embedding_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "management_configured": {
            "type": "boolean"
          },
          "mcp_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "proxy_port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "wiki_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "wiki_project_id": {
            "type": "string"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": [
          "ok",
          "proxy_running",
          "proxy_base_url",
          "mcp_url",
          "access_key_hint",
          "capabilities",
          "usage",
          "account_count",
          "capture_backend",
          "wiki_dir",
          "warnings",
          "onboarding",
          "workers"
        ],
        "properties": {
          "access_key_hint": {
            "type": "string"
          },
          "account_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "capture_backend": {
            "type": "string"
          },
          "embedding_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "mcp_url": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "onboarding": {
            "$ref": "#/components/schemas/OnboardingStatus"
          },
          "proxy_base_url": {
            "type": "string"
          },
          "proxy_running": {
            "type": "boolean"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageTotals"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Soft warnings for the desktop UI (port conflicts, onboarding hints)."
          },
          "wiki_dir": {
            "type": "string"
          },
          "wiki_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "workers": {
            "$ref": "#/components/schemas/WorkersStatus"
          }
        }
      },
      "UsageTotals": {
        "type": "object",
        "required": [
          "events",
          "tokens_in",
          "tokens_out"
        ],
        "properties": {
          "events": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tokens_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tokens_out": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "WorkersStatus": {
        "type": "object",
        "required": [
          "vector_search",
          "wiki",
          "embeddings",
          "wiki_pages",
          "role",
          "queue"
        ],
        "properties": {
          "embeddings": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "queue": {
            "type": "object"
          },
          "role": {
            "type": "string",
            "description": "Role this process claims (`RIVET_WORKER_ROLE`)."
          },
          "vector_search": {
            "type": "boolean"
          },
          "vectorize_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "wiki": {
            "type": "boolean"
          },
          "wiki_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "wiki_pages": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "control",
      "description": "Status, config, and session bootstrap"
    },
    {
      "name": "capture",
      "description": "Capture event queries"
    },
    {
      "name": "live",
      "description": "Live cursor / SSE refresh"
    }
  ]
}
